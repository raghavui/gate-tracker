{
  "manifest_version": 3,
  "name": "GATE Progress Tracker",
  "version": "1.0.0",
  "description": "Pick your GATE domain, assign your YouTube playlists to each subject, and this tracks what you've watched automatically.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content-watch.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GATE Tracker"
  }
}
